<Project Sdk="Microsoft.NET.Sdk">

  <!-- Exports canvas bitmaps (mob frames, item icons, skill icons, minimaps) from the client's WZ archives to PNG.
       The archives are only ever opened read-only. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>OakSoul.SpriteExport</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../OakSoul.Wz/OakSoul.Wz.csproj" />
  </ItemGroup>

</Project>
