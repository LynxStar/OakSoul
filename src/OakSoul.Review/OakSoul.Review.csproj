<Project Sdk="Microsoft.NET.Sdk">

  <!-- The review tool: an Avalonia desktop app for reviewing what the watcher concluded about a recording, frame by
       frame, with the overlay stream drawn as vectors over the recording's own pixels, a view of every track, the
       ground truth checked against the stream, and review packets of the reviewer's notes. Recordings only: nothing is
       captured, attached to or drawn over the game. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>OakSoul.Review</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/icon.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../OakSoul.Bake/OakSoul.Bake.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OakSoul.Review.Tests" />
  </ItemGroup>

</Project>
