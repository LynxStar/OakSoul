<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OakSoul.Review.App"
             Name="OakSoul Review"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme DensityStyle="Compact" />
    <Style Selector="TextBlock.panelTitle">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#9FB4C8" />
      <Setter Property="Margin" Value="0,10,0,4" />
    </Style>
    <Style Selector="TextBlock.value">
      <Setter Property="FontFamily" Value="Menlo, Consolas, monospace" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.dim">
      <Setter Property="Foreground" Value="#8A8A8A" />
    </Style>
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="#1C1F24" />
      <Setter Property="BorderBrush" Value="#2C3138" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="8,2,8,8" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <!-- The window's keys are its own (Space plays, Enter saves a note): a clicked button never keeps the keyboard focus,
         so Space or Enter never presses it again (Space on Regenerate restarted the regeneration). -->
    <Style Selector="Button, ToggleButton, RadioButton, CheckBox">
      <Setter Property="Focusable" Value="False" />
    </Style>
    <!-- The legend's chips: on, the item is drawn; off, dimmed. -->
    <Style Selector="ToggleButton.chip">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="Margin" Value="0,1,3,1" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Background" Value="#1E2228" />
      <Setter Property="Opacity" Value="0.45" />
    </Style>
    <Style Selector="ToggleButton.chip:checked">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="ToggleButton.chip:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#2C3A4C" />
      <Setter Property="Foreground" Value="#E8EEF4" />
    </Style>
    <Style Selector="Button.tool:checked">
      <Setter Property="Background" Value="#3A5A80" />
    </Style>
  </Application.Styles>
</Application>
